{
    "name": "frank-mendez-portfolio",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": ">=22.13.0"
    },
    "homepage": "https://frank-mendez.github.io",
    "scripts": {
        "build": "tsc -b && vite build",
        "deploy": "gh-pages -d dist",
        "dev": "vite",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" package.json \"tsconfig*.json\" vite.config.ts vitest.config.ts eslint.config.js README.md AGENTS.md CLAUDE.md \".github/workflows/*.yml\" .github/copilot-instructions.md",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "predeploy": "pnpm build",
        "prepare": "husky",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.27.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "simple-icons": "^16.27.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "daisyui": "^5.7.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "gh-pages": "^6.3.0",
        "globals": "^17.8.0",
        "happy-dom": "^20.11.1",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
